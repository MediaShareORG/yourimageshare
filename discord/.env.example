# Discord Developer Portal (https://discord.com/developers/applications) -
# Bot tab for the token, General Information tab for the application ID.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# YourImageShare API key - "API" tab at https://yourimageshare.com/my-account.
# All uploads from every server this bot is in land in this one account (v1
# limitation, see README).
YIS_API_KEY=
